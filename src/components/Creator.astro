---
import {getCollection} from 'astro:content';
import CreatorPortal from './CreatorPortal.astro';
import CreatorExperience from './crimson/CreatorExperience';
import type {Locale} from '../data/professional';
interface Props {language:Locale}
const {language}=Astro.props;
const games=(await getCollection('games')).sort((a,b)=>a.data.order-b.data.order).map(entry=>entry.data);
const endpoint=import.meta.env.PUBLIC_CONTACT_ENDPOINT?.trim()||'';
---
<div class="world world--creator" data-world="creator">
  <CreatorExperience language={language} games={games} endpoint={endpoint} client:visible={{rootMargin:'200px'}}>
    <CreatorPortal language={language} slot="portal"/>
  </CreatorExperience>
</div>
