---
import {getCollection} from 'astro:content';
import CreatorPortal from './CreatorPortal.astro';
import {creatorCopy as copy} from '../data/creator';
import {t,type Locale} from '../data/professional';
interface Props {language:Locale}
const {language}=Astro.props;
const games=(await getCollection('games')).sort((a,b)=>a.data.order-b.data.order).map(entry=>entry.data);
---
<div class="world world--creator" data-world="creator">
  <section class="hero" id="ctop"><div class="wrap hero__grid">
    <h1 class="hero__h1"><span class="hero__line">{t(copy.hero.line1,language)}</span><span class="hero__line">{t(copy.hero.line2,language)}</span></h1>
    <div class="hero__foot"><div class="hero__copy"><p class="hero__lead">{t(copy.hero.lead,language)}</p><div class="hero__actions"><a class="btn" href="#worlds">{t(copy.hero.projects,language)}</a><a class="quiet" href="https://github.com/NurHabibAssolihudin" target="_blank" rel="noreferrer">GitHub</a></div></div><CreatorPortal language={language}/></div>
  </div></section>
  <section class="work" id="worlds">
    <div class="wrap"><h2 class="h2 work__h">{t(copy.work.title,language)}</h2><p class="work__lead muted">{t(copy.work.lead,language)}</p></div>
    {games.map(game=><article class={'panel'+(game.flip?' panel--flip':'')}><div class="wrap panel__grid"><div class="panel__media panel__media--field"><p class="crest">{t(game.crest,language)}</p></div><div class="panel__text"><div class="panel__heading"><h3 class="panel__title">{t(game.name,language)}</h3><p class="panel__meta">{t(game.meta,language)}</p></div><p class="panel__body">{t(game.body,language)}</p><p class="panel__stack">{t(game.stack,language)}</p></div></div></article>)}
  </section>
  <section class="platforms craft-section" id="craft"><div class="wrap platforms__grid"><div class="platforms__lead"><h2 class="h2">{t(copy.process.title,language)}</h2><p class="muted">{t(copy.process.lead,language)}</p></div><div class="process-list">{copy.process.steps.map((step,index)=><details class="process-step" open={index===0}><summary><h3>{t(step.title,language)}</h3></summary><div class="details-body"><p>{t(step.body,language)}</p></div></details>)}</div></div></section>
  <section class="stack" id="tools"><div class="wrap stack__grid"><div><h2 class="h2">{t(copy.tools.title,language)}</h2><p class="muted">{t(copy.tools.lead,language)}</p></div><table class="table"><caption class="visually-hidden">{t(copy.tools.caption,language)}</caption><tbody>{copy.tools.rows.map(row=><tr><th scope="row">{t(row.term,language)}</th><td>{t(row.value,language)}</td></tr>)}</tbody></table></div></section>
  <section class="contact" id="play"><div class="wrap"><div class="card"><h2 class="card__h">{t(copy.contact.title,language)}</h2><p class="card__p">{t(copy.contact.lead,language)}</p><div class="card__actions"><a class="btn" href="mailto:nurhabibassolihudin12@gmail.com">Email</a><a class="quiet" href="https://github.com/NurHabibAssolihudin" target="_blank" rel="noreferrer">GitHub</a><a class="quiet" href="https://www.linkedin.com/in/nurhabib-assolihudin" target="_blank" rel="noreferrer">LinkedIn</a></div></div></div></section>
</div>
