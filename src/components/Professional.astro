---
import Panel from './Panel.astro';
import ExternalLink from './ExternalLink.astro';
import WorkPicker from './WorkPicker';
import ProjectReader from './ProjectReader.astro';
import { sections, t, words, type Locale } from '../data/professional';
import {projectContent} from '../lib/project-content';
interface Props { language: Locale; planet: string }
const {language, planet} = Astro.props;
const id = language === 'id';
const projects=await projectContent();
const pickerProjects=projects.map(({id,name,kind,summary,image,imageSet,imageWidth,imageHeight})=>({id,name,kind,summary,image,imageSet,imageWidth,imageHeight}));
---
<div class="pro-experience" data-enhanced="false" data-active="top">
    <div class="pro-scroll" id="professional-scroll" tabindex={-1} aria-label={id ? 'Bagian halaman profesional' : 'Professional page sections'}>
      <Panel section="top" class="hero pro-hero">
        <div class="hero__grid pro-hero__grid">
          <div class="pro-hero__copy"><h1 class="hero__h1" id="top-title" tabindex={-1}><span>Systems &amp;</span>{' '}<span>Product Engineer</span></h1>
            <p class="hero__lead">{t(words.introduction, language)}</p>
            <ul class="pro-hero__areas" aria-label={t(words.expertise, language)}>{words.areas.map(area => <li>{t(area, language)}</li>)}</ul>
            <div class="pro-actions"><a href="#work" class="pro-button">{t(words.view, language)}</a><a href="#contact" class="pro-link">{t(words.contact, language)}</a></div>
          </div>
          <div class="hero__core pro-portal"><Fragment set:html={planet} /></div>
        </div>
      </Panel>
      <Panel section="summary" class="pro-summary">
        <div class="pro-split"><div><h2 id="summary-title" class="pro-title" tabindex={-1}>{t(words.summary, language)}</h2><p class="pro-lead">{t(sections.summary.lead, language)}</p><p class="pro-body pro-summary__examples">{t(sections.summary.body, language)}</p><a class="pro-link" href="#work">{t(sections.summary.projects, language)}</a></div>
        <div class="pro-summary__scope"><h3 id="scope-title">{t(sections.summary.scopeTitle, language)}</h3><dl class="pro-scope-list" aria-labelledby="scope-title">{sections.summary.scope.map(item => <div><dt>{t(item.name, language)}</dt><dd>{t(item.description, language)}</dd></div>)}</dl></div></div>
      </Panel>
      <section id="work" class="pro-panel pro-work" data-chapter aria-labelledby="work-title"><div class="pro-content"><WorkPicker language={language} projects={pickerProjects} client:visible={{rootMargin:'400px'}} /></div></section>
      <Panel section="experience-work" class="pro-experience-section">
        <div class="pro-split">
          <h2 class="pro-title" id="experience-work-title" tabindex={-1}>{t(words.experience, language)}</h2>
          <article class="pro-employment" aria-labelledby="employment-role">
            <h3 id="employment-role">{sections.experience.role}</h3>
            <p class="pro-employment__company">{sections.experience.employer}</p>
            <dl><div><dt>{t(sections.experience.durationLabel, language)}</dt><dd>{t(sections.experience.duration, language)}</dd></div></dl>
            <ExternalLink url="https://www.linkedin.com/in/nurhabib-assolihudin" label={t(sections.experience.profile, language)} />
          </article>
        </div>
      </Panel>
      <Panel section="approach" class="pro-approach"><div class="pro-split"><div><h2 class="pro-title" id="approach-title" tabindex={-1}>{t(words.approach, language)}</h2><p class="pro-lead">{t(sections.approach.lead, language)}</p></div><ol class="pro-approach-list" role="list">{sections.approach.steps.map(step => <li><h3>{t(step.title, language)}</h3><p>{t(step.body, language)}</p></li>)}</ol></div></Panel>
      <Panel section="contact" class="pro-contact"><div class="pro-contact__layout"><div><h2 class="pro-title" id="contact-title" tabindex={-1}>{t(sections.contact.title, language)}</h2><p class="pro-lead">{t(sections.contact.lead, language)}</p><div class="pro-contact__email"><a class="pro-button" href="mailto:nurhabibassolihudin12@gmail.com">{t(sections.contact.email, language)}</a><a class="pro-email" href="mailto:nurhabibassolihudin12@gmail.com">nurhabibassolihudin12@gmail.com</a></div></div><aside class="pro-contact__aside" aria-labelledby="contact-profiles-title"><h3 id="contact-profiles-title">{t(sections.contact.profiles, language)}</h3><ul class="pro-contact__links" role="list"><li><ExternalLink url="https://github.com/NurHabibAssolihudin" label="GitHub" /></li><li><ExternalLink url="https://www.linkedin.com/in/nurhabib-assolihudin" label="LinkedIn" /></li></ul><p class="pro-signature">NurHabib Assolihudin</p></aside></div></Panel>
    </div>
    <ProjectReader projects={projects} language={language}/>
  </div>
