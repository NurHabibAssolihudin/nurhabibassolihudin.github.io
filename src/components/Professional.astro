---
import Panel from './Panel.astro';
import ExternalLink from './ExternalLink.astro';
import WorkPicker from './WorkPicker';
import { projects, t, words, type Locale } from '../data/professional';
interface Props { language: Locale; planet: string }
const {language, planet} = Astro.props;
const id = language === 'id';
---
<div class="pro-experience" data-enhanced="false" data-active="top">
    <div class="pro-scroll" id="professional-scroll" tabindex={-1} aria-label={id ? 'Bagian halaman profesional' : 'Professional page sections'}>
      <Panel section="top" class="hero pro-hero">
        <div class="hero__grid pro-hero__grid">
          <div class="pro-hero__copy"><h1 class="hero__h1" id="top-title" tabindex={-1}><span>{id ? 'Halo,' : 'Hello,'}</span><span>{id ? 'saya Nur.' : "I'm Nur."}</span></h1>
            <p class="hero__lead">{t(words.introduction, language)}</p><div class="pro-actions"><a href="#work" class="pro-button">{t(words.view, language)}<span aria-hidden="true">↓</span></a><a href="#summary" class="pro-link">{t(words.summary, language)}</a></div>
          </div>
          <div class="hero__core pro-portal"><Fragment set:html={planet} /><p class="hero__corecap">{id ? 'Ada dunia lainnya.' : 'There is another world.'} <button type="button" data-cross class="core-link accent">alimagine ↗</button></p></div>
        </div>
      </Panel>
      <Panel section="summary" class="pro-summary">
        <div class="pro-split"><div><h2 id="summary-title" class="pro-title" tabindex={-1}>{t(words.summary, language)}</h2><p class="pro-lead">{id ? 'Saya mengerjakan sisi teknis sekaligus arah produk pada proyek-proyek pribadi saya.' : 'In my personal projects, I work on both the technical side and the direction of the product.'}</p><a class="pro-link" href="#experience-work">{id ? 'Lihat latar belakang saya' : 'Explore my background'} <span aria-hidden="true">↓</span></a></div>
        <div class="pro-summary__scope"><p class="pro-body">{id ? 'Ruang kerja untuk proyek, perangkat lunak bisnis, hingga library untuk aplikasi web. Setiap pekerjaan punya kebutuhan dan pertimbangan yang berbeda.' : 'A workspace for projects, business software, and a library for web applications. Each one brings different needs and decisions.'}</p><dl class="pro-scope-list"><div><dt>{id ? 'Arah' : 'Direction'}</dt><dd>{id ? 'Branding dan perencanaan' : 'Branding and planning'}</dd></div><div><dt>{id ? 'Pembuatan' : 'Development'}</dt><dd>{id ? 'Kode dan deployment' : 'Code and deployment'}</dd></div><div><dt>{id ? 'Pengenalan' : 'Introducing it'}</dt><dd>{id ? 'Marketing produk' : 'Product marketing'}</dd></div></dl></div></div>
      </Panel>
      <section id="work" class="pro-panel pro-work" data-chapter aria-labelledby="work-title"><WorkPicker language={language} client:visible={{rootMargin:'400px'}} /></section>
      {projects.map(project => <Panel section={project.id} class="pro-case">
        <div class="pro-case__layout"><div class="pro-case__intro"><h2 class="pro-title" id={`${project.id}-title`} tabindex={-1}>{project.name}</h2><p class="pro-lead">{t(project.kind, language)}</p><p class="pro-body">{t(project.context, language)}</p>{project.image && <a class="pro-thumb" href={project.image} target="_blank" rel="noreferrer" aria-label={(id ? 'Buka gambar ' : 'Open image of ') + project.name}><img src={project.image} width={1360} height={860} alt={id ? `Preview halaman ${project.name}` : `${project.name} page preview`} loading="lazy" /><span>{id ? 'Lihat gambar' : 'View image'} ↗</span></a>}</div>
        <div class="pro-case__details"><div><h3>{t(words.contribution, language)}</h3><p>{t(words.responsibility, language)}</p><p>{t(project.focus, language)}</p></div><div><h3>{t(words.evidence, language)}</h3><p>{t(project.evidence, language)}</p><div class="pro-link-list">{project.links.map(link => <span><ExternalLink url={link.url} label={t(link.label, language)} /></span>)}</div></div><p class="pro-stack">{project.stack.join(' · ')}</p><a class="pro-link" href="#work">← {t(words.back, language)}</a></div></div>
      </Panel>)}
      <Panel section="experience-work" class="pro-experience-section"><div class="pro-split"><div><h2 class="pro-title" id="experience-work-title" tabindex={-1}>R&amp;D<br />Developer.</h2><p class="pro-lead">PT Semesta Teknologi Informatika</p><p class="pro-duration">{id ? 'Lebih dari satu tahun' : 'More than one year'}</p></div><div class="pro-experience__aside"><h3>{id ? 'Di luar pekerjaan sehari-hari' : 'Alongside my day-to-day work'}</h3><p class="pro-body">{id ? 'Saya mengembangkan Ocaty, ORCA, dan Oxelot sebagai proyek pribadi. Di sana saya menangani perencanaan, branding, pengembangan, deployment, dan marketing.' : 'I develop Ocaty, ORCA and Oxelot as personal projects, handling their planning, branding, development, deployment and marketing.'}</p><a href="#work" class="pro-link">{t(words.view, language)} <span aria-hidden="true">↗</span></a><ExternalLink url="https://www.linkedin.com/in/nurhabib-assolihudin" label={id ? 'Profil LinkedIn' : 'LinkedIn profile'} /></div></div></Panel>
      <Panel section="approach" class="pro-approach"><div class="pro-split"><div><h2 class="pro-title" id="approach-title" tabindex={-1}>{t(words.approach, language)}</h2><p class="pro-lead">{id ? 'Pada proyek pribadi, saya mengikuti pekerjaannya dari arah awal sampai cara memperkenalkannya.' : 'In personal projects, I follow the work from its initial direction to how it is introduced.'}</p></div><ol class="pro-approach-list"><li><h3>{id ? 'Menentukan arah' : 'Setting a direction'}</h3><p>{id ? 'Perencanaan produk dan branding menjadi bagian dari pekerjaan saya.' : 'Product planning and branding are part of my work.'}</p></li><li><h3>{id ? 'Mengerjakan produknya' : 'Building the product'}</h3><p>{id ? 'Saya mengerjakan kode dan deployment untuk proyek-proyek tersebut.' : 'I work on the code and deployment for these projects.'}</p></li><li><h3>{id ? 'Memperkenalkannya' : 'Introducing it'}</h3><p>{id ? 'Marketing juga saya tangani sebagai bagian dari pengembangan proyek pribadi.' : 'I also handle marketing as part of developing my personal projects.'}</p></li></ol></div></Panel>
      <Panel section="contact" class="pro-contact"><div class="pro-contact__layout"><div><h2 class="pro-title" id="contact-title" tabindex={-1}>{id ? 'Mari berbincang.' : "Let's talk."}</h2><p class="pro-lead">{id ? 'Ada yang ingin dibuat atau dibahas? Ceritakan kebutuhanmu, kita mulai dari sana.' : 'Have something to build or discuss? Tell me what you need, and we can start there.'}</p><a class="pro-button" href="mailto:nurhabibassolihudin12@gmail.com">{id ? 'Tulis email' : 'Write an email'} <span aria-hidden="true">↗</span></a><a class="pro-email" href="mailto:nurhabibassolihudin12@gmail.com">nurhabibassolihudin12@gmail.com</a></div><div class="pro-contact__aside"><p>{id ? 'Mulai dari ceritanya.' : 'Start with the story.'}</p><div class="pro-contact__links"><ExternalLink url="https://github.com/NurHabibAssolihudin" label="GitHub" /><ExternalLink url="https://www.linkedin.com/in/nurhabib-assolihudin" label="LinkedIn" /></div><p class="pro-signature">NurHabib Assolihudin</p></div></div></Panel>
    </div>
  </div>
