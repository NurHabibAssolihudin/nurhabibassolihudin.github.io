---
import Panel from './Panel.astro';
import ExternalLink from './ExternalLink.astro';
import WorkPicker from './WorkPicker';
import ProjectReader from './ProjectReader.astro';
import ContactSection from './ContactSection.astro';
import { sections, t, words, type Locale } from '../data/professional';
import {projectContent} from '../lib/project-content';
interface Props { language: Locale; planet: string }
const {language, planet} = Astro.props;
const id = language === 'id';
const projects=await projectContent();
const pickerProjects=projects.map(({id,name,kind,summary,image,imageSet,imageWidth,imageHeight})=>({id,name,kind,summary,image,imageSet,imageWidth,imageHeight}));
---
<div class="pro-experience" data-enhanced="false" data-active="top">
    <div class="pro-scroll" id="professional-scroll" tabindex={-1} aria-label={id ? 'Bagian halaman profesional' : 'Professional page sections'}>
      <Panel section="top" class="hero pro-hero">
        <div class="hero__grid pro-hero__grid">
          <div class="pro-hero__heading">
            <p class="pro-hero__name" data-chapter-entry="rise">NurHabib Assolihudin</p>
            <h1 class="hero__h1" id="top-title" tabindex={-1}>
              <span class="pro-hero__line"><span data-chapter-entry="line">Systems &amp;</span></span>
              <span class="pro-hero__line"><span data-chapter-entry="line">Product Engineer</span></span>
            </h1>
          </div>
          <div class="hero__core pro-portal" data-chapter-entry="orbit"><Fragment set:html={planet} /></div>
          <div class="pro-hero__copy">
            <p class="hero__lead" data-chapter-entry="rise">{t(words.introduction, language)}</p>
            <div class="pro-actions" data-chapter-entry="rise"><a href="#work" class="pro-button">{t(words.view, language)}</a><a href="#contact" class="pro-link">{t(words.contact, language)}</a></div>
          </div>
        </div>
      </Panel>
      <Panel section="summary" class="pro-summary">
        <div class="pro-summary__layout">
          <div>
            <h2 id="summary-title" class="pro-title" tabindex={-1} data-chapter-entry="rise">{t(words.summary, language)}</h2>
            <p class="pro-lead" data-chapter-entry="rise">{t(sections.summary.lead, language)}</p>
            <p class="pro-body pro-summary__examples" data-chapter-entry="rise">{t(sections.summary.body, language)}</p>
            <a class="pro-link" href="#work">{t(sections.summary.projects, language)}</a>
          </div>
          <div class="pro-summary__scope">
            <h3 id="scope-title" data-chapter-entry="rise">{t(sections.summary.scopeTitle, language)}</h3>
            <dl class="pro-scope-list" aria-labelledby="scope-title">
              {sections.summary.scope.map(item => (
                <div data-chapter-entry="slide"><dt>{t(item.name, language)}</dt><dd>{t(item.description, language)}</dd></div>
              ))}
            </dl>
          </div>
        </div>
      </Panel>
      <section id="work" class="pro-panel pro-work" data-chapter aria-labelledby="work-title"><div class="pro-content"><WorkPicker language={language} projects={pickerProjects} client:visible={{rootMargin:'400px'}} /></div></section>
      <Panel section="experience-work" class="pro-experience-section">
        <div class="pro-experience__layout">
          <h2 class="pro-title" id="experience-work-title" tabindex={-1} data-chapter-entry="rise">{t(words.experience, language)}</h2>
          <article class="pro-employment" aria-labelledby="employment-role">
            <div>
              <h3 id="employment-role" class="pro-text-mask"><span data-chapter-entry="line">{sections.experience.role}</span></h3>
              <p class="pro-employment__company" data-chapter-entry="rise">{sections.experience.employer}</p>
            </div>
            <div class="pro-employment__detail" data-chapter-entry="slide">
              <dl><div><dt>{t(sections.experience.durationLabel, language)}</dt><dd>{t(sections.experience.duration, language)}</dd></div></dl>
              <ExternalLink url="https://www.linkedin.com/in/nurhabib-assolihudin" label={t(sections.experience.profile, language)} />
            </div>
          </article>
        </div>
      </Panel>
      <Panel section="approach" class="pro-approach">
        <div class="pro-approach__intro">
          <h2 class="pro-title" id="approach-title" tabindex={-1} data-chapter-entry="rise">{t(words.approach, language)}</h2>
          <p class="pro-lead" data-chapter-entry="rise">{t(sections.approach.lead, language)}</p>
        </div>
        <ol class="pro-approach-list" role="list">
          {sections.approach.steps.map(step => (
            <li data-chapter-entry="rise"><h3>{t(step.title, language)}</h3><p>{t(step.body, language)}</p></li>
          ))}
        </ol>
      </Panel>
      <ContactSection language={language}/>
    </div>
    <ProjectReader projects={projects} language={language}/>
  </div>
